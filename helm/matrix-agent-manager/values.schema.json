{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1, "maximum": 1 },
    "image": {
      "type": "object",
      "required": ["reference"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "secretNamespace": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "config": {
      "type": "object",
      "required": ["environment", "httpAddr", "oidc", "mas", "matrix", "secretBackend"],
      "properties": {
        "environment": { "type": "string", "enum": ["development", "test", "production"] },
        "httpAddr": { "type": "string", "minLength": 1 },
        "sessionTTLSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
        "oidc": {
          "type": "object",
          "properties": {
            "issuerUrl": { "type": "string" },
            "clientId": { "type": "string" },
            "audience": { "type": "string" },
            "clientSecretFile": { "type": "string", "minLength": 1 },
            "redirectUrl": { "type": "string" },
            "rolesClaim": { "type": "string" },
            "requiredRoles": { "type": "string" },
            "adminRoles": { "type": "string" },
            "viewerRoles": { "type": "string" }
          },
          "required": ["issuerUrl", "clientId", "audience", "clientSecretFile", "redirectUrl", "rolesClaim", "requiredRoles"]
        },
        "mas": {
          "type": "object",
          "required": ["baseUrl", "tokenUrl", "usersUrl", "personalSessionsUrl", "clientId", "clientSecretFile"],
          "properties": {
            "baseUrl": { "type": "string" },
            "allowInsecureHTTP": { "type": "boolean" },
            "tokenUrl": { "type": "string" },
            "usersUrl": { "type": "string" },
            "personalSessionsUrl": { "type": "string" },
            "clientId": { "type": "string" },
            "clientSecretFile": { "type": "string", "minLength": 1 }
          }
        },
        "matrix": {
          "type": "object",
          "required": ["userIDTemplate", "profileURLTemplate"],
          "properties": {
            "userIDTemplate": { "type": "string" },
            "profileURLTemplate": { "type": "string" }
          }
        },
        "secretBackend": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["memory", "kubernetes"] },
            "namespace": { "type": "string" }
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "required": ["secretNamePrefix", "tokenScope", "deviceIDTemplate", "tokenExpirySeconds"],
      "properties": {
        "secretNamePrefix": { "type": "string" },
        "tokenScope": { "type": "string", "minLength": 1 },
        "deviceIDTemplate": { "type": "string", "minLength": 1 },
        "tokenExpirySeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "secretRefs": {
      "type": "object",
      "required": ["masClientSecret", "oidcClientSecret", "sessionKey"],
      "properties": {
        "masClientSecret": {
          "type": "object",
          "required": ["name", "key"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "oidcClientSecret": {
          "type": "object",
          "required": ["name", "key"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "sessionKey": {
          "type": "object",
          "required": ["name", "key"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "key": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "required": ["image", "config", "secretRefs"]
}
